 using NPZ
 
+function basis_inner_product_from_params(params::Parameters)
+    value = get(params["model"], "basis inner product", "euclidean")
+    value isa AbstractString || norma_abort("`model: basis inner product` must be `euclidean` or `mass`.")
+    mode = Symbol(lowercase(String(value)))
+    mode in (:euclidean, :mass) ||
+        norma_abort("`model: basis inner product` must be `euclidean` or `mass` (got '$value').")
+    return mode
+end
+
+function initial_basis_projector(basis::Array{Float64}, mode::Symbol)
+    num_modes = size(basis, 3)
+    if mode == :euclidean
+        return Matrix(reshape(basis, :, num_modes)')
+    end
+    return zeros(0, 0)
+end
+
+function build_mass_basis_projector(
+    basis::Array{Float64},
+    mass::SparseMatrixCSC{Float64,Int64},
+    free_dofs::BitVector;
+    validate::Bool=true,
+)
+    num_modes = size(basis, 3)
+    basis_matrix = reshape(basis, :, num_modes)
+    num_dofs = size(basis_matrix, 1)
+    size(mass) == (num_dofs, num_dofs) ||
+        norma_abort("Basis and consistent mass matrix have incompatible dimensions.")
+    length(free_dofs) == num_dofs ||
+        norma_abort("Basis and free-DOF mask have incompatible dimensions.")
+    any(free_dofs) || norma_abort("Cannot project a ROM state because there are no free full-order DOFs.")
+
+    projector = zeros(num_modes, num_dofs)
+    free_basis = basis_matrix[free_dofs, :]
+    free_mass = mass[free_dofs, free_dofs]
+    projector[:, free_dofs] .= free_basis' * free_mass
+
+    if validate
+        gram = projector * basis_matrix
+        identity_matrix = Matrix{Float64}(I, num_modes, num_modes)
+        gram_error = norm(gram - identity_matrix, Inf)
+        if !isfinite(gram_error) || gram_error > BASIS_ORTHONORMALITY_TOLERANCE
+            norma_abortf(
+                "The mass-weighted ROM basis is not M-orthonormal on the free DOFs: " *
+                "||Phi_f' * M_ff * Phi_f - I||_Inf = %.6e (tolerance %.1e, %d modes). " *
+                "Check the mesh, material densities, integration rules, DOF ordering, " *
+                "fixed-DOF mask, and basis construction.",
+                gram_error,
+                BASIS_ORTHONORMALITY_TOLERANCE,
+                num_modes,
+            )
+        end
+    end
+    return projector
+end
+
+function prepare_basis_projector!(model::OpInfModel; reuse_fom_mass::Bool=false)
+    model.basis_inner_product == :euclidean && return nothing
+    free_dofs = model.fom_model.free_dofs
+    if !isempty(model.basis_projector) && model.projector_free_dofs == free_dofs
+        return nothing
+    end
+
+    mass = assemble_consistent_mass_matrix(model.fom_model)
+    model.basis_projector = build_mass_basis_projector(model.basis, mass, free_dofs)
+    model.projector_free_dofs = copy(free_dofs)
+
+    if reuse_fom_mass
+        model.fom_model.mass = mass
+        model.fom_model.compute_mass = false
+    end
+    norma_log(1, :setup, "Prepared M-orthonormal ROM basis projector.")
+    return nothing
+end
+
+function project_fom_field(model::OpInfModel, field::AbstractArray{<:Real}; free_only::Bool=false)
+    num_full_dofs = size(model.basis, 1) * size(model.basis, 2)
+    num_field_dofs = length(field)
+    compatible = num_field_dofs == num_full_dofs ||
+        (model.basis_inner_product == :euclidean && num_field_dofs < num_full_dofs)
+    compatible || norma_abort("Basis and full-order field have incompatible dimensions.")
+    isempty(model.basis_projector) &&
+        norma_abort("The mass-weighted ROM basis projector has not been initialized.")
+    values = vec(field)
+    if free_only && model.basis_inner_product == :euclidean
+        values = copy(values)
+        values[.!model.fom_model.free_dofs] .= 0.0
+    end
+    if num_field_dofs == num_full_dofs
+        return model.basis_projector * values
+    end
+    return view(model.basis_projector, :, 1:num_field_dofs) * values
+end
