     return nothing
 end
 
+function _write_npz_array!(archive::ZipFile.Writer, name::String, value)
+    file = ZipFile.addfile(archive, name * ".npy"; method=ZipFile.Deflate)
+    try
+        NPZ.npzwritearray(file, value)
+    finally
+        close(file)
+    end
+    return nothing
+end
+
+# SciPy's sparse NPZ schema stores `format` as a zero-dimensional NumPy byte
+# string (dtype `|S3` for "csc"). NPZ.jl supports numeric and boolean arrays,
+# but not fixed-width byte strings, so write this one small NPY member directly.
+function _write_npz_ascii_scalar!(archive::ZipFile.Writer, name::String, value::String)
+    bytes = Vector{UInt8}(codeunits(value))
+    file = ZipFile.addfile(archive, name * ".npy"; method=ZipFile.Deflate)
+    try
+        write(file, UInt8[0x93, 'N', 'U', 'M', 'P', 'Y'])
+        write(file, UInt8[1, 0])
+        header = "{'descr': '|S$(length(bytes))', 'fortran_order': False, 'shape': (), }"
+        # NPY v1 requires the complete header (magic through newline) to end on
+        # a 64-byte boundary. The prefix is 6-byte magic + 2-byte version +
+        # 2-byte little-endian header length.
+        padding = mod(-(10 + ncodeunits(header) + 1), 64)
+        header = header * repeat(" ", padding) * "\n"
+        write(file, htol(UInt16(ncodeunits(header))))
+        write(file, header)
+        write(file, bytes)
+    finally
+        close(file)
+    end
+    return nothing
+end
+
+function _mass_matrix_filename(value)
+    value isa AbstractString || norma_abort("`mass matrix file` must be a file name.")
+    filename = String(value)
+    lowercase(splitext(filename)[2]) == ".npz" || norma_abort(
+        "`mass matrix file` must use the `.npz` extension (got '$filename').",
+    )
+    return filename
+end
+
+"""
+Write the initialized mass matrix as a DEFLATE-compressed, SciPy-compatible
+sparse CSC `.npz` archive.
+
+Implicit dynamics uses the consistent mass matrix assembled on `model.mass`.
+Explicit dynamics uses the lumped mass vector, represented as a diagonal CSC
+matrix so both integrator families share one output format.
+"""
+function write_mass_matrix(sim::SingleDomainSimulation)
+    filename_value = get(sim.params, "mass matrix file", nothing)
+    filename_value === nothing && return nothing
+    filename = _mass_matrix_filename(filename_value)
+
+    model = get_fom_model(sim)
+    mass_matrix = if !isempty(model.mass)
+        model.mass
+    elseif !isempty(model.lumped_mass)
+        spdiagm(0 => model.lumped_mass)
+    else
+        norma_abort(
+            "Cannot write `mass matrix file` for a simulation whose time integrator " *
+            "does not assemble a mass matrix. Use a dynamic time integrator.",
+        )
+    end
+
+    archive = ZipFile.Writer(filename)
+    try
+        _write_npz_array!(archive, "data", mass_matrix.nzval)
+        _write_npz_array!(archive, "indices", Int64.(mass_matrix.rowval .- 1))
+        _write_npz_array!(archive, "indptr", Int64.(mass_matrix.colptr .- 1))
+        _write_npz_array!(archive, "shape", Int64[size(mass_matrix, 1), size(mass_matrix, 2)])
+        _write_npz_ascii_scalar!(archive, "format", "csc")
+    finally
+        close(archive)
+    end
+    norma_log(0, :output, "Mass matrix: $(filename)")
+    return nothing
+end
