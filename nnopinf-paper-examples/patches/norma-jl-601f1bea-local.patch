+# Norma: Copyright 2025 National Technology & Engineering Solutions of
+# Sandia, LLC (NTESS). Under the terms of Contract DE-NA0003525 with NTESS,
+# the U.S. Government retains certain rights in this software. This software
+# is released under the BSD license detailed in the file license.txt in the
+# top-level Norma.jl directory.
+
+using SparseArrays
+
+@testset "M-orthonormal OpInf projection" begin
+    # Two nodes with component-fast ordering:
+    # [x1, y1, z1, x2, y2, z2].
+    free = BitVector([true, false, true, true, true, false])
+    A = [
+        2.0  0.4  0.1  0.3  0.0  0.2
+        0.1  1.8  0.2  0.0  0.5  0.1
+        0.3  0.2  1.7  0.4  0.1  0.0
+        0.0  0.3  0.2  1.9  0.4  0.2
+        0.2  0.0  0.1  0.3  1.6  0.5
+        0.1  0.4  0.0  0.2  0.3  1.5
+    ]
+    mass = sparse(A' * A + 0.5I)
+
+    phi = [1.0, 0.0, -0.5, 0.75, 0.25, 0.0]
+    phi ./= sqrt(dot(phi[free], mass[free, free] * phi[free]))
+    basis = reshape(phi, 3, 2, 1)
+
+    projector = Norma.build_mass_basis_projector(basis, mass, free)
+    @test projector * phi ≈ [1.0]
+    @test all(iszero, projector[:, .!free])
+
+    coordinate = 2.75
+    state = coordinate .* phi
+    state[.!free] .= [10.0, -4.0]
+    @test projector * state ≈ [coordinate]
+
+    # A full-M projection would include prescribed values through M_fc even
+    # though the basis itself is zero on constrained rows.
+    full_projection = dot(phi, mass * state)
+    @test !isapprox(full_projection, coordinate; atol=1.0e-8)
+
+    previous_test_mode = Norma.NORMA_TEST_MODE[]
+    Norma.NORMA_TEST_MODE[] = true
+    try
+        @test_throws Norma.NormaAbortException Norma.build_mass_basis_projector(2.0 .* basis, mass, free)
+        @test_throws Norma.NormaAbortException Norma.basis_inner_product_from_params(
+            Norma.Parameters("model" => Norma.Parameters("basis inner product" => "weighted"))
+        )
+    finally
+        Norma.NORMA_TEST_MODE[] = previous_test_mode
+    end
+
+    @test Norma.basis_inner_product_from_params(
+        Norma.Parameters("model" => Norma.Parameters())
+    ) == :euclidean
+    @test Norma.basis_inner_product_from_params(
+        Norma.Parameters("model" => Norma.Parameters("basis inner product" => "mass"))
+    ) == :mass
+
+    params = Norma.Parameters(
+        "type" => "single",
+        "model" => Norma.Parameters("basis inner product" => "mass"),
+    )
+    @test isempty(Norma.validate_input_parameters(params, "test.yaml"))
+end
+
