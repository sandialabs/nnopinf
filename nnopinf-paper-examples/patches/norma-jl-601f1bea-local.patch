 # the U.S. Government retains certain rights in this software. This software
 # is released under the BSD license detailed in the file license.txt in the
 # top-level Norma.jl directory.
+using NPZ
+using SparseArrays
+using ZipFile
+
+function read_sparse_npz(filename::String)
+    arrays = NPZ.npzread(filename, ["data", "indices", "indptr", "shape"])
+    matrix_shape = Int.(arrays["shape"])
+    return SparseMatrixCSC(
+        matrix_shape[1],
+        matrix_shape[2],
+        Int.(arrays["indptr"] .+ 1),
+        Int.(arrays["indices"] .+ 1),
+        arrays["data"],
+    )
+end
+
+function is_compressed_scipy_csc_npz(filename::String)
+    archive = ZipFile.Reader(filename)
+    try
+        entries = Dict(file.name => file for file in archive.files)
+        expected_names = Set(["data.npy", "indices.npy", "indptr.npy", "shape.npy", "format.npy"])
+        Set(keys(entries)) == expected_names || return false
+        all(file.method == ZipFile.Deflate for file in values(entries)) || return false
+
+        # SciPy requires a zero-dimensional byte string whose value is "csc".
+        # The final three bytes of this NPY member are the scalar's payload.
+        format_bytes = read(entries["format.npy"])
+        return length(format_bytes) >= 3 && format_bytes[(end - 2):end] == UInt8['c', 's', 'c']
+    finally
+        close(archive)
+    end
+end
+
 function average_components(V::Vector{Float64})
     x = mean(V[1:3:end])
     y = mean(V[2:3:end])
