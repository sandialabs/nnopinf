+"""
+Assemble the consistent finite-element mass matrix from the reference
+configuration without evaluating constitutive response or changing model state.
+"""
+function assemble_consistent_mass_matrix(model::SolidMechanics)
+    input_mesh = model.mesh
+    num_nodes = size(model.reference, 2)
+    num_dofs = 3 * num_nodes
+    mass_tl = create_threadlocal_coo_matrices(count_coo_matrix_nnz(model))
+
+    blocks = Exodus.read_sets(input_mesh, Block)
+    for (block_index, block) in enumerate(blocks)
+        density = model.materials[block_index].ρ
+        block_id = block.id
+        element_type_string = Exodus.read_block_parameters(input_mesh, block_id)[1]
+        element_type = element_type_from_string(element_type_string)
+        num_points = model.num_int_pts[block_index]
+        N, dN, ip_weights = isoparametric(element_type, num_points)
+        connectivity = get_block_connectivity(input_mesh, block_id)
+        num_block_elements, num_element_nodes = size(connectivity)
+        element_dofs_tl = [zeros(Int64, 3 * num_element_nodes) for _ in 1:maxthreadid()]
+        element_mass_tl = [zeros(3 * num_element_nodes, 3 * num_element_nodes) for _ in 1:maxthreadid()]
+
+        @threads for block_element_index in 1:num_block_elements
+            t = threadid()
+            connectivity_indices =
+                ((block_element_index - 1) * num_element_nodes + 1):(block_element_index * num_element_nodes)
+            node_indices = connectivity[connectivity_indices]
+            dofs = element_dofs_tl[t]
+            dofs .= reshape(3 .* node_indices' .- [2, 1, 0], :)
+            element_mass = element_mass_tl[t]
+            fill!(element_mass, 0.0)
+
+            element_reference_position = if model.mesh_smoothing
+                create_smooth_reference(
+                    model.smooth_reference,
+                    element_type,
+                    model.reference[:, node_indices],
+                    model.size_field,
+                    model.time,
+                )
+            else
+                model.reference[:, node_indices]
+            end
+
+            for point in 1:num_points
+                Np = N[:, point]
+                dXdξ = SMatrix{3,3,Float64,9}(dN[:, :, point] * element_reference_position')
+                det_dXdξ = det(dXdξ)
+                if !(det_dXdξ > 0.0 && isfinite(det_dXdξ))
+                    norma_abort("Cannot assemble ROM projection mass: non-positive reference-element Jacobian.")
+                end
+                reduced_mass = Np * Np' * density * det_dXdξ * ip_weights[point]
+                for component in 1:3
+                    element_mass[component:3:end, component:3:end] .+= reduced_mass
+                end
+            end
+            assemble!(mass_tl[t], element_mass, dofs)
+        end
+    end
+    return merge_threadlocal_coo_matrices(mass_tl, num_dofs)
+end
