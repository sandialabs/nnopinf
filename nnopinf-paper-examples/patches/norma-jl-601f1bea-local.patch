+function has_rom_initial_state(params::Parameters)
+  return haskey(params, "initial conditions") || get(params, "restart_info", nothing) !== nothing
+end
+
+function project_rom_initial_conditions!(params::Parameters, model::OpInfModel)
+  has_rom_initial_state(params) || return nothing
+  n_var, n_node, _ = size(model.basis)
+  size(model.fom_model.displacement) == (n_var, n_node) || norma_abort("Basis is wrong size")
+  model.reduced_state .= project_fom_field(model, model.fom_model.displacement)
+  model.reduced_velocity .= project_fom_field(model, model.fom_model.velocity)
+  if get(params, "restart_info", nothing) !== nothing
     norma_log(0, :restart, "Projected restarted FOM displacement/velocity onto the reduced basis.")
   end
+  return nothing
+end
+
+function apply_ics(params::Parameters, model::OpInfModel, integrator::TimeIntegrator, solver::Solver)
+  # Seed the shadow FOM first. Euclidean projection remains here to preserve
+  # legacy ordering exactly. Mass projection is deferred until apply_bcs has
+  # established the free-DOF mask and the M-weighted projector is prepared.
+  apply_ics(params, model.fom_model, integrator.fom_integrator, solver.fom_solver)
+  model.basis_inner_product == :euclidean && project_rom_initial_conditions!(params, model)
+  return nothing
