index 06297d6..16f5a99 100644
--- a/normaopinf/readers.py
+++ b/normaopinf/readers.py
@@ -1,5 +1,38 @@
 import os
 import numpy as np
+from scipy import sparse
+
+
+def read_mass_matrix_npz(path: str) -> sparse.csc_matrix:
+    """Load a Norma full-order mass matrix from a SciPy sparse NPZ file.
+
+    Norma writes the matrix in interleaved, node-major DOF ordering. This
+    reader intentionally preserves that ordering; the OpInf workflow performs
+    its ordering conversion once the number of snapshot variables and nodes is
+    known.
+    """
+    mass_matrix = sparse.load_npz(path).tocsc(copy=False)
+    if mass_matrix.shape[0] != mass_matrix.shape[1]:
+        raise ValueError(
+            f"Mass matrix must be square, got shape {mass_matrix.shape}"
+        )
+    if mass_matrix.shape[0] % 3 != 0:
+        raise ValueError(
+            "Mass matrix dimension must be divisible by three for x/y/z DOFs, "
+            f"got shape {mass_matrix.shape}"
+        )
+    if not np.issubdtype(mass_matrix.dtype, np.number):
+        raise ValueError(
+            f"Mass matrix must contain numeric values, got {mass_matrix.dtype}"
+        )
+    if not np.all(np.isfinite(mass_matrix.data)):
+        raise ValueError("Mass matrix contains non-finite values")
+
+    mass_matrix.eliminate_zeros()
+    mass_matrix.sort_indices()
+    return mass_matrix
+
+
