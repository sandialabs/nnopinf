+import numpy as np
+import pytest
+
+from normaopinf.opinf._regularization_gui import (
+    AUTOMATIC_MODE,
+    GROUPED_MODE,
+    SHARED_MODE,
+    build_regularization_setting,
+    default_groups,
+    parse_candidate_spec,
+    parse_grouped_specs,
+    search_combination_count,
+)
+
+
+def test_parse_explicit_candidates():
+    assert parse_candidate_spec("0, 1e-4, 2.5") == [0.0, 1.0e-4, 2.5]
+
+
+def test_parse_logspace_candidates():
+    result = parse_candidate_spec("logspace(-4, 1, 6)")
+    assert np.allclose(result, np.logspace(-4, 1, 6))
+
+
+@pytest.mark.parametrize(
+    "spec",
+    [
+        "",
+        "1e-4, nope",
+        "-1, 1",
+        "nan, 1",
+        "logspace(-4, 1)",
+        "logspace(-4, 1, 0)",
+        "logspace(-4, 1, 2.5)",
+    ],
+)
+def test_parse_candidate_spec_rejects_invalid_input(spec):
+    with pytest.raises(ValueError):
+        parse_candidate_spec(spec)
+
+
+@pytest.mark.parametrize(
+    ("model_type", "forcing", "expected"),
+    [
+        ("linear", False, ["A", "B"]),
+        ("linear", True, ["c", "A", "B"]),
+        ("quadratic", False, ["A", "H", "B"]),
+        ("cubic", False, ["A", "HG", "B"]),
+    ],
+)
+def test_default_groups(model_type, forcing, expected):
+    assert default_groups(model_type, forcing) == expected
+
+
+def test_parse_grouped_specs():
+    result = parse_grouped_specs(
+        [
+            ("a", "1e-4, 1e-3"),
+            ("hg", "logspace(-4, -3, 2)"),
+            ("b", "1e-2"),
+        ],
+        model_type="cubic",
+        forcing=False,
+    )
+    assert list(result) == ["A", "HG", "B"]
+    assert np.allclose(result["HG"], [1e-4, 1e-3])
+    assert search_combination_count(result) == 4
+
+
+@pytest.mark.parametrize(
+    "group_specs",
+    [
+        [("A", "1"), ("AH", "1"), ("B", "1")],
+        [("A", "1"), ("B", "1")],
+        [("AA", "1"), ("H", "1"), ("B", "1")],
+        [("A", "1"), ("X", "1"), ("H", "1"), ("B", "1")],
+        [],
+    ],
+)
+def test_parse_grouped_specs_rejects_invalid_groups(group_specs):
+    with pytest.raises(ValueError):
+        parse_grouped_specs(group_specs, model_type="quadratic", forcing=False)
+
+
+def test_grouped_specs_require_forcing_constant():
+    with pytest.raises(ValueError, match="missing c"):
+        parse_grouped_specs(
+            [("A", "1"), ("B", "1")],
+            model_type="linear",
+            forcing=True,
+        )
+
+
+def test_grouped_mode_rejects_neural_network_model():
+    with pytest.raises(ValueError, match="not supported"):
+        build_regularization_setting(
+            GROUPED_MODE,
+            "1",
+            [],
+            model_type="neural-network",
+            forcing=False,
+        )
+
+
+def test_build_automatic_and_shared_settings():
+    assert (
+        build_regularization_setting(
+            AUTOMATIC_MODE, "invalid", [], "linear", False
+        )
+        == "automatic"
+    )
+    shared = build_regularization_setting(
+        SHARED_MODE, "1e-4, 1e-3", [], "linear", False
+    )
+    assert shared == [1e-4, 1e-3]
+    assert search_combination_count(shared) == 2
