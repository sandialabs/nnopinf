+"""Sparse mass-matrix helpers for the OpInf offline workflow."""
+
+import numpy as np
+import scipy.linalg
+from scipy import sparse
+
+
+_MASS_RTOL = 1.0e-10
+_MASS_ATOL = 1.0e-12
+
+
+def _max_abs(matrix):
+    if matrix.nnz == 0:
+        return 0.0
+    return float(np.max(np.abs(matrix.data)))
+
+
+def _check_near_zero(matrix, scale, description):
+    error = _max_abs(matrix)
+    tolerance = _MASS_ATOL + _MASS_RTOL * scale
+    if error > tolerance:
+        raise ValueError(
+            f"Mass matrix {description} is not numerically zero: "
+            f"maximum magnitude {error:.6e} exceeds tolerance {tolerance:.6e}"
+        )
+
+
+def prepare_mass_matrix(mass_matrix, n_vars, n_nodes):
+    """Validate and convert an interleaved mass matrix to component-major order."""
+    if not sparse.issparse(mass_matrix):
+        raise TypeError("Mass matrix must be a SciPy sparse matrix")
+    if n_vars != 3:
+        raise ValueError(
+            f"Mass weighting requires exactly three snapshot variables, got {n_vars}"
+        )
+
+    expected_size = n_vars * n_nodes
+    expected_shape = (expected_size, expected_size)
+    if mass_matrix.shape != expected_shape:
+        raise ValueError(
+            "Mass matrix shape does not match the displacement snapshots: "
+            f"expected {expected_shape}, got {mass_matrix.shape}"
+        )
+
+    mass_matrix = mass_matrix.tocsc(copy=False)
+    difference = mass_matrix - mass_matrix.T
+    difference.eliminate_zeros()
+    scale = max(1.0, _max_abs(mass_matrix))
+    _check_near_zero(difference, scale, "symmetry error")
+
+    # Snapshots reshape in component-major order, while Norma writes node-major
+    # interleaved DOFs [x1, y1, z1, x2, y2, z2, ...].
+    permutation = np.arange(expected_size).reshape(n_nodes, n_vars).T.ravel()
+    reordered = mass_matrix[permutation, :][:, permutation].tocsc()
+    reordered.eliminate_zeros()
+    reordered.sort_indices()
+    return reordered
+
+
+def component_mass_blocks(mass_matrix, n_nodes):
+    """Return Mxx, Myy, and Mzz after validating zero cross-component blocks."""
+    scale = max(1.0, _max_abs(mass_matrix))
+    blocks = []
+    for row_component in range(3):
+        row_start = row_component * n_nodes
+        row_stop = row_start + n_nodes
+        blocks.append(
+            mass_matrix[row_start:row_stop, row_start:row_stop].tocsc()
+        )
+        for column_component in range(3):
+            if row_component == column_component:
+                continue
+            column_start = column_component * n_nodes
+            column_stop = column_start + n_nodes
+            cross_block = mass_matrix[
+                row_start:row_stop, column_start:column_stop
+            ]
+            _check_near_zero(
+                cross_block,
+                scale,
+                f"cross-component block ({row_component}, {column_component})",
+            )
+    return tuple(blocks)
+
+
+class SparseMatrixWeightedL2Orthogonalizer:
+    """Make a dense basis orthonormal in a sparse SPD matrix inner product."""
+
+    def __init__(self, weighting_matrix):
+        if not sparse.issparse(weighting_matrix):
+            raise TypeError("Weighting matrix must be a SciPy sparse matrix")
+        if weighting_matrix.shape[0] != weighting_matrix.shape[1]:
+            raise ValueError(
+                f"Weighting matrix must be square, got {weighting_matrix.shape}"
+            )
+        self._weighting_matrix = weighting_matrix
+
+    def orthogonalize(self, array):
+        if array.shape[0] != self._weighting_matrix.shape[0]:
+            raise ValueError(
+                "Weighting matrix does not match basis size: "
+                f"{self._weighting_matrix.shape[0]} != {array.shape[0]}"
+            )
+
+        gram = np.asarray(array.T @ (self._weighting_matrix @ array))
+        gram = 0.5 * (gram + gram.T)
+        try:
+            factor = scipy.linalg.cholesky(gram, lower=True, check_finite=True)
+        except scipy.linalg.LinAlgError as error:
+            raise ValueError(
+                "Mass-weighted reduced Gram matrix is not positive definite"
+            ) from error
+
+        inverse_factor_transpose = scipy.linalg.solve_triangular(
+            factor.T,
+            np.eye(factor.shape[0]),
+            lower=False,
+            check_finite=True,
+        )
+        return array @ inverse_factor_transpose
