@@ -0,0 +1,161 @@
+"""Parsing and validation helpers for GUI regularization settings."""
+
+import math
+import re
+
+import numpy as np
+
+
+AUTOMATIC_MODE = "Automatic"
+SHARED_MODE = "Shared grid"
+GROUPED_MODE = "Grouped grid"
+
+_SUPPORTED_OPERATORS = set("cAHGB")
+_MODEL_OPERATORS = {
+    "linear": set("AB"),
+    "linear-symmetric": set("AB"),
+    "quadratic": set("AHB"),
+    "cubic": set("AHGB"),
+}
+_LOGSPACE_PATTERN = re.compile(r"^logspace\((.*)\)$", re.IGNORECASE)
+
+
+def _validate_candidates(candidates):
+    if not candidates:
+        raise ValueError("At least one regularization candidate is required")
+    if not np.all(np.isfinite(candidates)):
+        raise ValueError("Regularization candidates must be finite")
+    if np.any(np.asarray(candidates) < 0):
+        raise ValueError("Regularization candidates must be nonnegative")
+    return [float(value) for value in candidates]
+
+
+def parse_candidate_spec(spec):
+    """Parse comma-separated floats or logspace(start, stop, count)."""
+    text = spec.strip()
+    if not text:
+        raise ValueError("Regularization candidate input cannot be empty")
+
+    logspace_match = _LOGSPACE_PATTERN.fullmatch(text)
+    if logspace_match:
+        arguments = [part.strip() for part in logspace_match.group(1).split(",")]
+        if len(arguments) != 3:
+            raise ValueError(
+                "logspace requires start exponent, stop exponent, and count"
+            )
+        try:
+            start = float(arguments[0])
+            stop = float(arguments[1])
+            count = int(arguments[2])
+        except ValueError as error:
+            raise ValueError(
+                "logspace arguments must be two numbers and an integer count"
+            ) from error
+        if count <= 0:
+            raise ValueError("logspace count must be positive")
+        return _validate_candidates(np.logspace(start, stop, count).tolist())
+
+    if text.lower().startswith("logspace"):
+        raise ValueError(
+            "Invalid logspace syntax; use logspace(start, stop, count)"
+        )
+
+    try:
+        candidates = [float(part.strip()) for part in text.split(",")]
+    except ValueError as error:
+        raise ValueError(
+            "Regularization candidates must be comma-separated numbers"
+        ) from error
+    return _validate_candidates(candidates)
+
+
+def _normalize_group(group):
+    normalized = []
+    for operator in group.strip():
+        normalized.append("c" if operator in "cC" else operator.upper())
+    return "".join(normalized)
+
+
+def required_operators(model_type, forcing):
+    if model_type not in _MODEL_OPERATORS:
+        raise ValueError(
+            f"Grouped regularization is not supported for model type {model_type!r}"
+        )
+    operators = set(_MODEL_OPERATORS[model_type])
+    if forcing:
+        operators.add("c")
+    return operators
+
+
+def default_groups(model_type, forcing):
+    """Return one-time seed groups for a grouped GUI search."""
+    if model_type in ("linear", "linear-symmetric"):
+        groups = ["A", "B"]
+    elif model_type == "quadratic":
+        groups = ["A", "H", "B"]
+    elif model_type == "cubic":
+        groups = ["A", "HG", "B"]
+    else:
+        raise ValueError(
+            f"Grouped regularization is not supported for model type {model_type!r}"
+        )
+    return (["c"] if forcing else []) + groups
+
+
+def parse_grouped_specs(group_specs, model_type, forcing):
+    """Convert GUI group/spec pairs to a backend-compatible candidate dictionary."""
+    required = required_operators(model_type, forcing)
+    if not group_specs:
+        raise ValueError("Add at least one regularization group")
+
+    result = {}
+    used = set()
+    for raw_group, candidate_spec in group_specs:
+        group = _normalize_group(raw_group)
+        if not group:
+            raise ValueError("Regularization group names cannot be empty")
+        operators = set(group)
+        if len(operators) != len(group):
+            raise ValueError(f"Regularization group {group!r} repeats an operator")
+        unsupported = operators - _SUPPORTED_OPERATORS
+        if unsupported:
+            raise ValueError(
+                f"Regularization group {group!r} contains unsupported operators"
+            )
+        overlap = operators & used
+        if overlap:
+            raise ValueError(
+                "Regularization operators may appear in only one group: "
+                + ", ".join(sorted(overlap))
+            )
+        used.update(operators)
+        result[group] = parse_candidate_spec(candidate_spec)
+
+    if used != required:
+        missing = "".join(sorted(required - used))
+        extra = "".join(sorted(used - required))
+        details = []
+        if missing:
+            details.append(f"missing {missing}")
+        if extra:
+            details.append(f"not used by this model: {extra}")
+        raise ValueError("Regularization groups do not match the model (" + "; ".join(details) + ")")
+    return result
+
+
+def build_regularization_setting(mode, shared_spec, group_specs, model_type, forcing):
+    if mode == AUTOMATIC_MODE:
+        return "automatic"
+    if mode == SHARED_MODE:
+        return parse_candidate_spec(shared_spec)
+    if mode == GROUPED_MODE:
+        return parse_grouped_specs(group_specs, model_type, forcing)
+    raise ValueError(f"Unknown regularization mode {mode!r}")
+
+
+def search_combination_count(setting):
+    if isinstance(setting, dict):
+        return math.prod(len(candidates) for candidates in setting.values())
+    if isinstance(setting, list):
+        return len(setting)
+    return 1
